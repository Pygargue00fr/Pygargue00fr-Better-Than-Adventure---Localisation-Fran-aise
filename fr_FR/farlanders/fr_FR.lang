subtitles.mob.farlander.slip = Mouvement de voyageur  
subtitles.mob.farlander.whispering = Chuchotement de voyageur

# GUIDEBOOK #
farlanders.guidebook.section.mob.farlander.name = Voyageur
farlanders.guidebook.section.mob.farlander.desc = Leurs lentilles peuvent servir à fabriquer des lunettes permettant de voir à travers les murs, et leurs perles peuvent être utilisées pour le transport et la production de fumée.
