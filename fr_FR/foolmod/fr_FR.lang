subtitles.foolmod.fool.hit=Le corniaud attaque
# halplibe namespaces item keys, so these are item.<modid>.<name>.name -- not the bare
# item.<name>.name that vanilla BTA uses for its own items.
# Joxe Dust is a BLOCK now, so its item is keyed tile.* rather than item.* — placing it was what
# changed the key and broke the name.
tile.foolmod.joxe_dust.name=Poudre de perlimpinpin
tile.foolmod.joxe_dust.desc=Poudre de foire. Tracez un cercle fermé au sol — vos murs peuvent en tenir lieu pour une partie — et le corniaud n'y mettra pas les pieds.
tile.foolmod.fools_gold_block.name=Bloc d'or des fous
tile.foolmod.fools_gold_block.desc=Neuf lingots, empilés. Ça ne vaut absolument rien.
item.foolmod.fools_gold_ingot.name=Lingo d'or des fous
item.foolmod.fools_gold_ingot.desc=Ne vaut rien et sert à tout.
